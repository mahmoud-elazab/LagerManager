# Copy to .env, keep private, and fill every required value before starting.
# No example passwords or signing keys are supplied.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# Base64 encoding of at least 32 random bytes; choose deliberately.
# Do not overwrite the existing IntelliJ key or put it in an image/build argument.
LAGERMANAGER_JWT_SECRET=
# Optional host HTTP port. Only the frontend is published, on loopback.
FRONTEND_PORT=8082
